#include <stdio.h>

int main() {
    int a[] = {3,4,6,-9,10,8,9,30};
    int n = 8, key, i, found = 0;

    printf("Enter key: ");
    scanf("%d", &key);

    for(i = 0; i < n; i++) {
        if(a[i] == key) {
            printf("Element %d is found at position %d", key, i + 1);
            found = 1;
            break;
        }
    }

    if(!found)
        printf("Element %d is not found", key);

    return 0;
}
