#include <stdio.h>
#include <string.h>

int main() {
    char *words[] = {"abc", "car", "ada", "racecar", "cool"};
    int n = 5, i, j, flag;

    for (i = 0; i < n; i++) {
        flag = 1;
        int len = strlen(words[i]);

        for (j = 0; j < len / 2; j++) {
            if (words[i][j] != words[i][len - j - 1]) {
                flag = 0;
                break;
            }
        }

        if (flag) {
            printf("%s", words[i]);
            return 0;
        }
    }

    printf("");
    return 0;
}
