#include <stdio.h>

void quickSort(int a[], int low, int high) {
    if (low >= high) return;

    int i = low, j = high, pivot = a[(low + high) / 2], temp;

    while (i <= j) {
        while (a[i] < pivot) i++;
        while (a[j] > pivot) j++;

        if (i <= j) {
            temp = a[i];
            a[i] = a[j];
            a[j] = temp;
            i++;
            j--;
        }
    }

    quickSort(a, low, j);
    quickSort(a, i, high);
}

int main() {
    int a[100], n, i;

    printf("Enter size: ");
    scanf("%d", &n);

    if (n == 0) {
        printf("List is empty");
        return 0;
    }

    printf("Enter elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    quickSort(a, 0, n - 1);

    printf("Sorted List: ");
    for (i = 0; i < n; i++)
        printf("%d ", a[i]);

    printf("\nMaximum Element: %d", a[n - 1]);

    return 0;
}
