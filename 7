#include <stdio.h>

int main() {
    int a[100], unique[100];
    int n, i, j, count = 0, found;

    printf("Enter size: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    for(i = 0; i < n; i++) {
        found = 0;

        for(j = 0; j < count; j++) {
            if(a[i] == unique[j]) {
                found = 1;
                break;
            }
        }

        if(!found)
            unique[count++] = a[i];
    }

    printf("Unique elements: ");
    for(i = 0; i < count; i++)
        printf("%d ", unique[i]);

    return 0;
}
