#include <stdio.h>

int main() {
    int a[] = {2,3,2}, b[] = {1,2};
    int n = 3, m = 2, i, j, ans1 = 0, ans2 = 0;

    for(i = 0; i < n; i++)
        for(j = 0; j < m; j++)
            if(a[i] == b[j]) {
                ans1++;
                break;
            }

    for(i = 0; i < m; i++)
        for(j = 0; j < n; j++)
            if(b[i] == a[j]) {
                ans2++;
                break;
            }

    printf("[%d,%d]", ans1, ans2);

    return 0;
}
